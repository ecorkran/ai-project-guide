#!/usr/bin/env bash
# Lint and format-check staged Python files with ruff. No silent skip.
set -euo pipefail

staged=()
while IFS= read -r f; do
  staged+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.py')

if [ "${#staged[@]}" -eq 0 ]; then
  exit 0
fi

if ! command -v ruff >/dev/null 2>&1; then
  echo "ruff not found; install it (uv tool install ruff)" >&2
  exit 1
fi

ruff check "${staged[@]}"
ruff format --check "${staged[@]}"
